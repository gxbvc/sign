#!/usr/bin/env ruby
# Deploy only the pinned, unmodified public release. Never build this checkout.
require "json"
require "yaml"
require "shellwords"

Dir.chdir(File.expand_path("..", __dir__))
release = JSON.parse(File.read("deploy/release.json"))
config = YAML.safe_load_file("config/deploy.yml")
abort "Unexpected image" unless release.fetch("image") == config.fetch("image")
abort "Invalid version" unless release.fetch("version").match?(/\A\d+\.\d+\.\d+\z/)
abort "Invalid digest" unless release.fetch("digest").match?(/\Asha256:[a-f0-9]{64}\z/)
abort "Commit deployment changes first" unless `git status --porcelain -- config/deploy.yml deploy bin/deploy-sign`.strip.empty?
abort "Deployment checks failed" unless system(RbConfig.ruby, "deploy/check.rb")

host = config.fetch("servers").fetch("web").fetch("hosts").fetch(0)
image = "#{release.fetch('image')}@#{release.fetch('digest')}"
tag = "#{release.fetch('image')}:#{release.fetch('version')}"
remote = "docker inspect kamal-proxy --format '{{.State.Running}}' | grep -qx true && " \
         "docker pull #{Shellwords.escape(image)} && " \
         "docker tag #{Shellwords.escape(image)} #{Shellwords.escape(tag)}"
abort "Image pull or proxy check failed" unless system("ssh", "-o", "BatchMode=yes", "root@#{host}", remote)

ENV["BUNDLE_GEMFILE"] = File.expand_path("deploy/Gemfile")
exec "bundle", "exec", "kamal", "app", "boot", "--version", release.fetch("version")
