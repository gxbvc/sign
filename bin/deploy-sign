#!/usr/bin/env ruby
# Build this committed tree as ghcr.io/gxbvc/sign:<commit>, test candidates, then activate.
# Usage: bin/deploy-sign BACKUP_TARBALL_NAME   (a file in /opt/sign/backups/ on the host, for candidate mode B)
# Never restarts or replaces the shared kamal-proxy. Never runs `kamal app remove`.
require 'json'
require 'yaml'
require 'erb'
require_relative '../deploy/prepare'
require_relative '../deploy/source_archive'
require_relative '../deploy/publish_source'

Dir.chdir(File.expand_path('..', __dir__))
backup = ARGV.fetch(0) { abort 'Usage: bin/deploy-sign BACKUP_TARBALL_NAME (from /opt/sign/backups/)' }
release = JSON.parse(File.read('deploy/release.json'))
version = `git rev-parse HEAD`.strip
abort 'Invalid deployment commit' unless version.match?(/\A[a-f0-9]{40}\z/)
abort 'Commit all changes first (the image is built from this working tree)' unless `git status --porcelain`.strip.empty?
config = YAML.safe_load(ERB.new(File.read('config/deploy.yml')).result)
abort 'Unexpected image' unless "#{config.dig('registry', 'server')}/#{config.fetch('image')}" == release.fetch('image')
abort 'Deployment checks failed' unless system(RbConfig.ruby, 'deploy/check.rb')

host = config.fetch('servers').fetch('web').fetch('hosts').first
abort 'Shared proxy is not running' unless system('ssh', '-o', 'BatchMode=yes', "root@#{host}",
                                                 "docker inspect kamal-proxy --format '{{.State.Running}}' | grep -qx true")

SignSourceArchive.write(version)
ENV['BUNDLE_GEMFILE'] = File.expand_path('deploy/Gemfile')
kamal = %w[bundle exec kamal]
abort 'Registry login failed' unless system(*kamal, 'registry', 'login')
abort 'Image build and push failed' unless system(*kamal, 'build', 'push', '--version', version)
abort 'Tree changed during build' unless `git status --porcelain`.strip.empty? && `git rev-parse HEAD`.strip == version
SignPrepare.run(version, backup)

# Publish the source before the new version serves users (AGPL section 13).
abort 'Publishing source failed' unless SignPublishSource.run(version)

# redeploy: pull, stop stale containers, boot the app. Unlike `deploy`, it does not boot kamal-proxy.
exec(*kamal, 'redeploy', '--skip-push', '--version', version)
