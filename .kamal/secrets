# Values live outside Git in ~/.config/sign/smtp.json, auth.json, and chat.json (mode 0600).
SMTP_USERNAME=$(ruby deploy/secret.rb smtp SMTP_USERNAME)
SMTP_PASSWORD=$(ruby deploy/secret.rb smtp SMTP_PASSWORD)
AUTH_GXB_CLIENT_SECRET=$(ruby deploy/secret.rb auth AUTH_GXB_CLIENT_SECRET)
CHAT_API_KEY=$(ruby deploy/secret.rb chat CHAT_API_KEY)

# GHCR push and pull. Uses the deploying operator's GitHub login (needs write:packages).
KAMAL_REGISTRY_PASSWORD=$(gh auth token)
